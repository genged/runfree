{
  "domains": [
    "api.anthropic.com",
    "api.firecrawl.dev",
    "api.github.com",
    "api.npmjs.org",
    "api.openai.com",
    "auth.openai.com",
    "chatgpt.com",
    "code.claude.com",
    "codeload.github.com",
    "developers.openai.com",
    "docs.claude.com",
    "docs.npmjs.com",
    "files.pythonhosted.org",
    "github.com",
    "mcp.posthog.com",
    "oauth.posthog.com",
    "objects.githubusercontent.com",
    "platform.claude.com",
    "pypi.org",
    "raw.githubusercontent.com",
    "registry.npmjs.org",
    "sentry.io",
    "statsig.anthropic.com"
  ],
  "tokens": {
    "github": {
      "description": "Read-only GitHub API token for rate limit and public metadata",
      "allowAnonymous": true,
      "credentials": [
        {
          "host": "api.github.com",
          "header": "Authorization",
          "scheme": "bearer"
        },
        {
          "host": "raw.githubusercontent.com",
          "header": "Authorization",
          "scheme": "bearer"
        }
      ]
    },
    "firecrawl": {
      "description": "firecrawl token",
      "credentials": [
        {
          "host": "api.firecrawl.dev",
          "header": "Authorization",
          "scheme": "bearer"
        }
      ]
    }
  }
}
