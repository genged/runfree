// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`output baseline: command transcripts > bare group command 1`] = `
{
  "status": 1,
  "stderr": "<ts> runfree error: runfree host needs a subcommand

runfree host

Manage the exact-host network allowlist

Commands:
  runfree host add <host>      Allow an exact host and optionally restrict its requests
  runfree host remove <host>   Remove a host from the allowlist
  runfree host list            Print allowlisted hosts
  runfree host explain <host>  Show a host's allowlist status, credentials, and request rules
  runfree host rules <host>    Show or change a host's request rules

Options:
  -h, --help  Show help  [boolean]

Examples:
  runfree host add api.github.com                                Allow an exact host
  runfree host add pypi.org --read-only                          Allow a host, GET/HEAD/OPTIONS only
  runfree host rules api.example.com --method GET --method POST  Allow only specific methods (repeatable)
  runfree host rules github.com --deny-git-push                  Allow the host but block git push
  runfree host remove api.github.com                             Remove an unreferenced host
  runfree host list                                              List allowlisted hosts
  runfree host explain api.github.com                            Show allowlist status, credentials, and request rules
  runfree host rules api.github.com                              Show the host's request rules (--clear removes them)
  runfree host rules api.github.com --write ask                  Hold writes to this host for approval

Hosts are exact hostnames; there are no wildcards. The allowlist is the proxy egress boundary.
",
  "stdout": "",
}
`;

