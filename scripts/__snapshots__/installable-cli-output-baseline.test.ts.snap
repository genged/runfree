exports[`output baseline: command transcripts > init on a fresh project 1`] = `
{
  "status": 0,
  "stderr": "",
  "stdout": "project: <project>
runfree config: <project>/.runfree/runfree.json
network policy: <project>/.runfree/network-policy.json
outbound services: none (deny-all)
start Claude or Codex to review its required operational service
after the first start, enable services with: runfree service enable <id>
service ids are listed by: runfree service enable --help
",
}
`;

